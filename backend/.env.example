# ---- Required in production ----
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-random-50-character-secret

# PostgreSQL connection string. REQUIRED when DEBUG=False.
# SQLite is refused in production because container disks are ephemeral.
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# ---- Local development ----
# DEBUG=True enables SQLite, permissive CORS and Django's media/static serving.
DEBUG=False

# Comma separated hostnames allowed to serve the API (production only).
ALLOWED_HOSTS=your-backend.onrender.com

# Comma separated frontend origins allowed to call the API (production only).
# Leave empty to fall back to *.vercel.app / *.netlify.app / *.onrender.com.
CORS_ALLOWED_ORIGINS=https://your-menu.vercel.app,https://your-admin.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-menu.vercel.app,https://your-admin.vercel.app

# ---- Optional ----
# Persistent disk mount for uploaded food images (Render: add a disk and point here).
# Without it, uploads are lost on redeploy — use the image_url field instead.
# MEDIA_ROOT=/var/data/media

# Set to False to disable outbound Google Translate calls on save.
AUTO_TRANSLATE=True

# Max upload size for food images, in bytes (default 10 MB).
MAX_UPLOAD_IMAGE_SIZE=10485760

# Set to False if your host terminates TLS without an X-Forwarded-Proto header.
SECURE_SSL_REDIRECT=True

LOG_LEVEL=INFO
