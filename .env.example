# Copy to .env next to docker-compose.yml before running `docker compose up --build`.
# Never commit the real .env file.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-random-50-character-secret

DB_NAME=mehmon_db
DB_USER=mehmon_user
DB_PASSWORD=replace-me-with-a-strong-database-password

# Where the browser reaches the API from (baked into the frontend bundles at build time).
CLIENT_API_URL=http://localhost:8000/api
ADMIN_API_URL=http://localhost:8000/api
